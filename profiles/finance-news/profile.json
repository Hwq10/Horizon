{
  "id": "finance-news",
  "name": "Financial News",
  "display_names": {
    "zh": "财经新闻"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "content": {
    "analysis_max_chars": 4000,
    "enrichment_max_chars": 8000,
    "sampling": "prefix"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      { "id": "summary", "type": "section", "tools": [], "primary": true },
      { "id": "background", "type": "section", "tools": ["web_search"] },
      { "id": "logic", "type": "section", "tools": [] },
      { "id": "consensus", "type": "section", "tools": ["web_search"] },
      { "id": "cycle", "type": "section", "tools": [], "optional": true },
      { "id": "insight", "type": "section", "tools": [] },
      { "id": "outlook", "type": "section", "tools": [], "optional": true },
      { "id": "risk", "type": "section", "tools": [] },
      { "id": "impact", "type": "section", "tools": ["web_search"], "optional": true }
    ]
  }
}
