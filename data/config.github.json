{
  "ai": {
    "provider": "openai",
    "model": "gemini-3.8-flash",
    "base_url": "https://modelflare.dev/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "software-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "semiconductors",
        "profile": "tech-news"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux-kernel",
        "profile": "tech-news"
      },
      {
        "name": "量子位",
        "url": "https://www.qbitai.com/feed",
        "enabled": true,
        "category": "ai-news-zh",
        "profile": "tech-news"
      },
      {
        "name": "极客公园",
        "url": "https://www.geekpark.net/rss",
        "enabled": true,
        "category": "tech-zh",
        "profile": "tech-news"
      },
      {
        "name": "少数派",
        "url": "https://sspai.com/feed",
        "enabled": true,
        "category": "tech-zh",
        "profile": "tech-news"
      },
      {
        "name": "阮一峰的网络日志",
        "url": "https://www.ruanyifeng.com/blog/atom.xml",
        "enabled": true,
        "category": "tech-zh",
        "profile": "tech-news"
      },
      {
        "name": "MarketWatch Top Stories",
        "url": "https://feeds.marketwatch.com/marketwatch/topstories",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "Bloomberg Markets",
        "url": "https://feeds.bloomberg.com/markets/news.rss",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "Reuters Business",
        "url": "https://feeds.reuters.com/reuters/businessNews",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "FT Markets",
        "url": "https://www.ft.com/rss/markets",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "WSJ Markets",
        "url": "https://feeds.wsj.com/wsj/xml/rss/3_7014.xml",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "华尔街见闻·要闻",
        "url": "https://rsshub.rssforever.com/wallstreetcn/live/global",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "华尔街见闻·A股",
        "url": "https://rsshub.rssforever.com/wallstreetcn/live/a-stock",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "华尔街见闻·港股",
        "url": "https://rsshub.rssforever.com/wallstreetcn/live/hk-stock",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "华尔街见闻·美股",
        "url": "https://rsshub.rssforever.com/wallstreetcn/live/us-stock",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "Howard Marks (Oaktree 备忘录)",
        "url": "https://rss.art19.com/the-memo-by-howard-marks",
        "enabled": true,
        "category": "value-investing",
        "profile": "finance-news"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": [
            "tech-news",
            "finance-news"
          ]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 20,
    "profile_order": [
      "finance-news",
      "tech-news",
      "tech-blog"
    ],
    "group_by": "profile",
    "category_groups": {
      "finance": {
        "name": "Finance",
        "limit": 12,
        "categories": [
          "finance-news"
        ]
      },
      "tech": {
        "name": "AI / Tech",
        "limit": 8,
        "categories": [
          "tech-news",
          "tech-blog"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 0
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "smtp_username": null,
    "imap_enabled": false,
    "imap_server": "",
    "imap_port": 993,
    "email_address": "3649936288@qq.com",
    "password_env": "EMAIL_PASSWORD",
    "sender_name": "Horizon Daily"
  }
}
